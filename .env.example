# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BOOKINGS_NOTIFY_EMAIL=
BOOKINGS_FROM_EMAIL=
# Turnstile. Preview and Development use Cloudflare's test keys (always pass):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel Blob uses OIDC. Get both with `vercel env pull` (see ARCHITECTURE.md section 6).
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Local only: path to the master film used by the pnpm media:* scripts.
KOBA_MASTER_FILM=
