{
  "name": "koba-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "media:hero": "node scripts/media/hero.mjs",
    "media:stills": "node scripts/media/stills.mjs",
    "media:film": "node scripts/media/film.mjs",
    "media": "pnpm media:hero && pnpm media:stills && pnpm media:film",
    "media:film:upload": "node scripts/media/upload-film.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "fonts": "node scripts/fonts/build.mjs"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.1",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@next/env": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/blob": "2.8.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "ffmpeg-static": "5.3.0",
    "fontverter": "2.0.0",
    "harfbuzzjs": "1.6.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@12.11.2",
  "description": "Koba: Ethiopian fine dining in Gastown, Vancouver.",
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
